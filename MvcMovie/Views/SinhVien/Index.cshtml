@model IEnumerable<MvcMovie.Models.SinhVien>

@{
    ViewData["Title"] = "Quản lý sinh viên";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-mortarboard-fill text-primary me-2"></i>Quản lý sinh viên
            </h2>
            <p class="text-muted mb-0">Danh sách sinh viên và thông tin khoa</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm px-4 py-2 rounded-3">
            <i class="bi bi-plus-circle me-2"></i>Thêm sinh viên
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="row align-items-center g-2">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control bg-light border-start-0 ps-0"
                               placeholder="Tìm theo mã sinh viên, họ tên hoặc khoa...">
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="badge bg-primary-subtle text-primary fs-6 fw-normal px-3 py-2 rounded-pill">
                        Tổng: <strong>@(Model != null ? Model.Count() : 0)</strong> sinh viên
                    </span>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="studentTable">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3" style="width: 20%;">Mã sinh viên</th>
                        <th class="py-3" style="width: 32%;">Họ tên</th>
                        <th class="py-3" style="width: 28%;">Khoa</th>
                        <th class="text-end pe-4 py-3" style="width: 20%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var tenParts = (item.HoTen ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var chuCaiDau = tenParts.Length > 0 ? tenParts.Last()[0].ToString().ToUpper() : "SV";

                            <tr>
                                <td class="ps-4 fw-semibold text-primary">@item.MaSinhVien</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center me-3 fw-bold"
                                             style="width: 36px; height: 36px; font-size: 0.85rem;">
                                            @chuCaiDau
                                        </div>
                                        <span class="fw-medium text-dark">@item.HoTen</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2 rounded-pill fw-normal">
                                        @(item.Khoa?.TenKhoa ?? "Chưa cập nhật")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.MaSinhVien"
                                           class="btn btn-sm btn-outline-warning text-dark fw-medium px-3">
                                            <i class="bi bi-pencil-square me-1"></i>Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaSinhVien"
                                           class="btn btn-sm btn-outline-danger fw-medium px-3">
                                            <i class="bi bi-trash3 me-1"></i>Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                Chưa có dữ liệu sinh viên nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.getElementById('searchInput').addEventListener('keyup', function () {
        const keyword = this.value.toLowerCase();
        const rows = document.querySelectorAll('#studentTable tbody tr');
        rows.forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(keyword) ? '' : 'none';
        });
    });
</script>